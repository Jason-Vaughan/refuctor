{
  "name": "@puberty-labs/refuctor",
  "version": "0.1.0-beta.1",
  "description": "AI-powered, snark-fueled technical debt cleansing suite that turns code cleanup into a darkly humorous financial metaphor.",
  "main": "src/index.js",
  "bin": {
    "refuctor": "cli/refuctor-cli.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "jest",
    "lint": "eslint src/ cli/ --ext .js",
    "lint:fix": "eslint src/ cli/ --ext .js --fix",
    "build": "npm run lint && npm test",
    "dev": "nodemon src/index.js",
    "scan": "markdownlint-cli '*.md' && cspell '**/*.{md,js,json,ts}'",
    "shame": "node cli/refuctor-cli.js shame",
    "wrap": "node cli/refuctor-cli.js wrap"
  },
  "keywords": [
    "technical-debt",
    "code-quality",
    "linting",
    "refactoring",
    "developer-tools",
    "cli",
    "automation",
    "debt-management",
    "code-cleanup",
    "mcp",
    "cursor",
    "ai-tools"
  ],
  "author": "Puberty Labs <dev@pubertylabs.com>",
  "license": "MIT",
  "homepage": "https://github.com/puberty-labs/refuctor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puberty-labs/refuctor.git"
  },
  "bugs": {
    "url": "https://github.com/puberty-labs/refuctor/issues"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "commander": "^11.0.0",
    "chalk": "^5.3.0",
    "inquirer": "^9.2.0",
    "glob": "^10.3.0",
    "fs-extra": "^11.2.0",
    "moment": "^2.29.0",
    "ora": "^7.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.0",
    "markdownlint-cli": "^0.39.0",
    "cspell": "^8.3.0",
    "@types/node": "^20.11.0"
  },
  "peerDependencies": {
    "markdownlint-cli": ">=0.39.0",
    "cspell": ">=8.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "cli/",
    "templates/",
    "README.md",
    "REFUCTOR_ROADMAP.md",
    "package.json"
  ],
  "preferGlobal": true,
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/puberty-labs"
  }
} 